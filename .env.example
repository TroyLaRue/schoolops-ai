# Documentation only. These are NOT working credentials. Configure actual values
# in Replit Secrets (or a local untracked .env). Never commit credentials or student data.

# Required for authenticated school operations (Replit DB supplies this at runtime).
DATABASE_URL=YOUR_DATABASE_URL

# Required for authenticated school operations (Replit-managed Clerk can provide these).
CLERK_SECRET_KEY=YOUR_CLERK_SECRET_KEY
CLERK_PUBLISHABLE_KEY=YOUR_CLERK_PUBLISHABLE_KEY
VITE_CLERK_PUBLISHABLE_KEY=YOUR_CLERK_PUBLISHABLE_KEY

# Optional: browser Clerk proxy URL, if configured for your host.
VITE_CLERK_PROXY_URL=YOUR_CLERK_PROXY_URL

# PORT and BASE_PATH are provided separately to artifact workflows in Replit.
# Gmail and Calendar use optional Replit integrations, not OAuth secrets in this file.
# Smartcare has no live connector or credential in this project.